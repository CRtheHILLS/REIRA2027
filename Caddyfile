# Static hosting for reirasj.com on Railway.
# Railway terminates TLS at its edge and injects $PORT, so Caddy serves plain
# HTTP on that port and never tries to provision its own certificate.
{
	admin off
	persist_config off
	auto_https off
	log {
		format console
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	# Both reirasj.com and www.reirasj.com are routed here by Railway. Send
	# www to the apex so one host is canonical — og:url, the canonical link
	# and the sitemap all name the bare domain, and a crawler that can reach
	# the same pages under two hosts splits their ranking between them.
	@www host www.reirasj.com
	redir @www https://reirasj.com{uri} permanent

	root * /srv
	encode zstd gzip
	file_server

	# Content-addressed enough to cache hard: subsetted webfonts and pinned
	# vendor bundles only change when their filename changes.
	@immutable path /assets/fonts/* /vendor/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Images and the runtime keep stable names across redeploys, so cap them
	# at a day — long enough to help, short enough that a swap goes live.
	@daily path /assets/img/* /assets/js/*
	header @daily Cache-Control "public, max-age=86400"

	@html path / *.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle_errors {
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
